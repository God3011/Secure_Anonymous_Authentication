# Build output
target/

# IDE / OS
.idea/
*.iml
.DS_Store

# Key material: keep the folder, never the contents
Keys/*
!Keys/.gitkeep

# Signatures are regenerated at runtime by TE / MECS
Signature/*
!Signature/.gitkeep

# Private keys, keystores, certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.csr
*.sign

# Secrets / environment
.env
.env.*

# Generated / large test data
*.enc
output.txt
.metars.xml
